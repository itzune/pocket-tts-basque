# Copy to .env and fill in. .env is git-ignored.

# Hugging Face token (read access). Needed for gated datasets such as
# xezpeleta/mozilla-common-voice-20-eu and for pushing the dataset/model later (write).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GPU VM used for generation / training (ssh as root)
GPU_VM=root@your-gpu-vm

# Where data lives on the VM
VM_DATA_DIR=/root/data

# Weights & Biases (optional): streams training progress + audio samples via scripts/wandb_sidecar.py
WANDB_API_KEY=
WANDB_ENTITY=

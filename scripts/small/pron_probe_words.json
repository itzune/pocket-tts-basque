{"tt": ["Antton etorri da gaur goizean.", "Pittin bat itxaron, mesedez.", "Ttipi-ttapa joan ziren mendira.", "Haur ttikia lotan dago.", "Kuttuna zara niretzat.", "Pottoka bat ikusi dugu bidean.", "Ttantta bat ur nahikoa da.", "Aitta, nora goaz bihar?"],
 "dd": ["Onddo asko bildu ditugu basoan.", "Maddi eta Maddalen ahizpak dira.", "Txaddan bat dago aldapan behera.", "Hori ez da gauza iddikia."],
 "ll": ["Pello Bilbon bizi da.", "Bide llaburra hartuko dugu.", "Ollo horrek arrautzak jarri ditu.", "Eskerrik asko, Mikel eta Pello."],
 "ñ": ["Andereñoa gelan sartu da.", "Iñaki Iruñean jaio zen.", "Oñatira joango gara igandean.", "Ekaitzak oñaztuak ekarri ditu."],
 "j": ["Julen eta Jon anaiak dira.", "Jende asko joan da jaialdira.", "Jolasean ari ziren haurrak.", "Jose jantzi berria erosi du.", "Gaur jai dugu eskolan."],
 "ge_gi": ["Gero gizon bat etorri zen gelara.", "Giltza galdu dut berriro.", "Egin dezagun elkarrekin.", "Gipuzkoan euria egin du."],
 "x": ["Joxe eta Xabier lagunak dira.", "Xaguak axola gutxi du katuari.", "Xinaurriak lanean ari dira.", "Ez dio axola, lasai."],
 "tz_ts_tx": ["Etxe hotz batean bizi dira.", "Itsasoa urdin dago gaur.", "Hitz hauek ikasi behar dituzu."]}
